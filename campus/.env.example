# ── Campus numérique 2IAE : variables d'environnement ──────────────────────
# Seules DATABASE_URL et SESSION_SECRET sont indispensables en production.
# Chaque intégration se met en veille proprement quand sa clé manque.

# Base PostgreSQL (tables dans le schéma « campus »). Sur Railway :
#   DATABASE_URL=${{Postgres-Campus.DATABASE_URL}}
DATABASE_URL=postgresql://postgres@localhost:5433/campus
# DATABASE_SSL=true|false   (auto : désactivé sur *.railway.internal et localhost)

# Sécurité (valeur aléatoire : openssl rand -hex 32)
SESSION_SECRET=changez-moi

# Compte de la direction créé au premier démarrage
CAMPUS_ADMIN_EMAIL=direction@2iae.com
CAMPUS_ADMIN_PASSWORD=
# CAMPUS_ADMIN_PRENOM=Direction
# CAMPUS_ADMIN_NOM=2IAE

# Adresse publique du campus (liens des e-mails, QR des fiches, vitrine)
# CAMPUS_PUBLIC_URL=https://campus.2iae.com

# Lien avec le site vitrine www.2iae.com
SITE_URL=https://www.2iae.com
# SITE_ORIGINS=https://www.2iae.com,https://2iae.com
# Adresse où prévenir le site (réseau privé Railway) :
# SITE_WEBHOOK_URL=http://${{2iae.RAILWAY_PRIVATE_DOMAIN}}:8080
# Secret partagé avec le site (même valeur des deux côtés)
# CAMPUS_WEBHOOK_SECRET=

# Fichiers déposés (devoirs, ressources) : volume Railway monté sur /data
UPLOADS_DIR=/data/uploads
# UPLOAD_MAX_MB=25

# Visio : Daily.co (recommandé), sinon Jitsi, sinon lien externe / scène de démonstration
# DAILY_API_KEY=
# DAILY_DOMAIN=groupe2iae
# JITSI_DOMAIN=meet.jit.si
# Visio intégrée du campus (pair-à-pair, sans compte externe) :
#   serveurs TURN pour les réseaux mobiles derrière CGNAT (fortement conseillé en production)
# TURN_URLS=turns:turn.example.com:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
#   étudiants en ligne qui reçoivent la vidéo du formateur / places en visio au total
#   (au-delà, ils suivent « à la radio » : son + diapos, ≈ 12 à 15 Mo/h)
# VISIO_PLACES_VIDEO=8
# VISIO_PLACES_TOTAL=40

# Assistant IA (Claude). Sur Railway : ANTHROPIC_API_KEY=${{2iae.ANTHROPIC_API_KEY}}
# ANTHROPIC_API_KEY=
# CAMPUS_IA_MODELE=claude-opus-5
# CAMPUS_IA_QUOTA_JOUR=40

# E-mails (Resend, domaine 2iae.com déjà vérifié pour le site)
# RESEND_API_KEY=
# CAMPUS_MAIL_FROM=Campus numérique 2IAE <campus@2iae.com>

# Notifications sur le téléphone (Web Push) : npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT=mailto:campus@2iae.com

# Données de démonstration au démarrage (cours IA-101, étudiants fictifs…)
# CAMPUS_DEMO=true
