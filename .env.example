# ── Base de données (obligatoire) ─────────────────────────────────────────────
# Sur Railway : ajoutez un service PostgreSQL puis référencez la variable :
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Force ou désactive le SSL vers la base (auto-détecté par défaut :
# désactivé pour *.railway.internal et localhost, activé sinon en production)
# DATABASE_SSL=true

# ── Sécurité (obligatoire en production) ──────────────────────────────────────
# Générez une valeur aléatoire, ex. : openssl rand -hex 32
SESSION_SECRET=changez-moi-valeur-aleatoire-secrete

# Identifiants du compte admin créé au premier démarrage
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changez-moi-mot-de-passe-fort
ADMIN_EMAIL=admin@2iae.com

# ── Chatbot OpenAI (optionnel — le chatbot est désactivé sans cette clé) ─────
OPENAI_API_KEY=your_openai_api_key_here

# ── Uploads (optionnel) ───────────────────────────────────────────────────────
# Répertoire de stockage des fichiers uploadés.
# Sur Railway, montez un volume et pointez cette variable vers son chemin,
# sinon les fichiers sont perdus à chaque redéploiement.
# UPLOADS_DIR=/data/uploads

# Stockage objet S3-compatible (DigitalOcean Spaces / Cloudflare R2 / AWS S3).
# Si configuré, les uploads y sont envoyés au lieu du disque local.
# DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# DO_SPACES_KEY=
# DO_SPACES_SECRET=
# DO_SPACES_BUCKET=

# ── Divers ────────────────────────────────────────────────────────────────────
NODE_ENV=production
# Domaine(s) supplémentaire(s) autorisé(s) pour le CORS, séparés par des virgules
# APP_URL=https://www.mondomaine.com
