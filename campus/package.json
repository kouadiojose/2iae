{
  "name": "campus-2iae",
  "version": "1.0.0",
  "private": true,
  "description": "Campus numérique du Groupe Écoles 2IAE International",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx --env-file-if-exists=.env server/index.ts",
    "build": "vite build && esbuild server/index.ts server/scripts/migrate.ts server/scripts/seed.ts server/scripts/purger-demo.ts --platform=node --packages=external --bundle --format=esm --outdir=dist --define:process.env.NODE_ENV=\\\"production\\\"",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "db:generate": "drizzle-kit generate && node server/scripts/corriger-migrations.mjs",
    "db:push:dev": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs push --force",
    "db:migrate": "node dist/scripts/migrate.js",
    "db:migrate:dev": "tsx --env-file-if-exists=.env server/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env server/scripts/seed.ts",
    "db:seed:prod": "node dist/scripts/seed.js",
    "db:purge-demo": "tsx --env-file-if-exists=.env server/scripts/purger-demo.ts",
    "db:purge-demo:prod": "node dist/scripts/purger-demo.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@daily-co/daily-js": "^0.92.2",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-tabs": "^1.1.4",
    "@tanstack/react-query": "^5.60.5",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "compression": "^1.8.0",
    "connect-pg-simple": "^10.0.0",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.39.1",
    "drizzle-zod": "^0.7.0",
    "express": "^4.21.2",
    "express-session": "^1.18.2",
    "lucide-react": "^0.453.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "web-push": "^3.6.7",
    "wouter": "^3.3.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.0.0",
    "@types/node": "20.16.11",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.4",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "vite": "^5.4.19"
  }
}
