# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Environment
NODE_ENV=production

# Database Connection Details (auto-generated by DigitalOcean)
PGHOST=your_postgres_host
PGPORT=5432
PGUSER=your_postgres_user
PGPASSWORD=your_postgres_password
PGDATABASE=your_database_name

# Note: These environment variables will be automatically set by DigitalOcean App Platform
# when you connect a managed database. You only need to manually set OPENAI_API_KEY.